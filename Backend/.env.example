NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# PostgreSQL
DB_HOST=localhost
DB_PORT=5433
DB_NAME=cineview_dev
DB_USER=cineview
DB_PASSWORD=change_me_in_local_env
DB_SSL=false

# Redis
REDIS_URL=redis://localhost:6379

# Security & Sessions
# SESSION_SECRET=I8*McA%qxJ3hD;I=CD9j4hQ03KRT$k8W
SESSION_COOKIE_NAME=cineview.sid
SESSION_TTL_SECONDS=86400
# CSRF_SECRET=uSMTY^s;@54DLXbjhY$*|p:_ZwJ<C[8y
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Payments & Tickets (Demo Stripe-compatible mode by default)
PAYMENT_PROVIDER=demo
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=whsec_demo_cineview_secret
TICKET_QR_SECRET=replace_with_at_least_32_char_qr_hmac_secret

# Logging
LOG_LEVEL=info
