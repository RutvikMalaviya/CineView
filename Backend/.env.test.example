NODE_ENV=test
PORT=4001
API_PREFIX=/api/v1

DB_HOST=localhost
DB_PORT=5432
DB_NAME=cineview_test
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

REDIS_URL=redis://localhost:6379

SESSION_SECRET=key
SESSION_COOKIE_NAME=cineview.test.sid
SESSION_TTL_SECONDS=3600
CSRF_SECRET=key
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Payments & Tickets (Demo Stripe-compatible mode by default)
PAYMENT_PROVIDER=demo
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=whsec_demo_cineview_secret
TICKET_QR_SECRET=replace_with_at_least_32_char_qr_hmac_secret

LOG_LEVEL=silent
